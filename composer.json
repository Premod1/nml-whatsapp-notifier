{
    "name": "nml/whatsapp-notifier",
    "description": "WhatsApp Cloud API Wrapper and Notification Channel for Laravel and PHP",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Premod1/nml-whatsapp-notifier",
    "authors": [
        {
            "name": "Premod Suraweera",
            "email": "premodsuraweera1@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Premod1/nml-whatsapp-notifier/issues",
        "source": "https://github.com/Premod1/nml-whatsapp-notifier"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nml\\WhatsApp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nml\\WhatsApp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nml\\WhatsApp\\WhatsAppServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
